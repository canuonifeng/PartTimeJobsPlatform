<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.parttime.cservice.mapper.ApplicationScheduleMapper">

    <insert id="insert">
        INSERT INTO application_schedules (application_id, schedule_id)
        VALUES (#{applicationId}, #{scheduleId})
    </insert>

    <select id="findByApplicationId" resultType="com.parttime.cservice.pojo.entity.ApplicationSchedule">
        SELECT * FROM application_schedules WHERE application_id = #{applicationId}
    </select>

</mapper>
