<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.parttime.cservice.mapper.TrainingCertificationMapper">

    <resultMap id="TrainingCertificationMap" type="com.parttime.cservice.pojo.entity.TrainingCertification">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="code" column="code"/>
        <result property="taskType" column="task_type"/>
        <result property="description" column="description"/>
        <result property="validDays" column="valid_days"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findById" resultMap="TrainingCertificationMap">
        SELECT * FROM training_certifications WHERE id = #{id}
    </select>

    <select id="findActiveByTaskType" resultMap="TrainingCertificationMap">
        SELECT * FROM training_certifications WHERE status = 'ACTIVE' AND task_type = #{taskType} ORDER BY id DESC
    </select>

    <select id="findByIds" resultMap="TrainingCertificationMap">
        SELECT * FROM training_certifications WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

</mapper>
