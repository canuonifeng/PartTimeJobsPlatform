<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.parttime.cservice.mapper.WorkerTrainingRecordMapper">

    <resultMap id="WorkerTrainingRecordMap" type="com.parttime.cservice.pojo.entity.WorkerTrainingRecord">
        <id property="id" column="id"/>
        <result property="workerId" column="worker_id"/>
        <result property="courseId" column="course_id"/>
        <result property="status" column="status"/>
        <result property="score" column="score"/>
        <result property="startedAt" column="started_at"/>
        <result property="completedAt" column="completed_at"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findByWorkerAndCourse" resultMap="WorkerTrainingRecordMap">
        SELECT * FROM worker_training_records WHERE worker_id = #{workerId} AND course_id = #{courseId} LIMIT 1
    </select>

    <select id="findByWorkerId" resultMap="WorkerTrainingRecordMap">
        SELECT * FROM worker_training_records WHERE worker_id = #{workerId}
    </select>

    <insert id="insert" parameterType="com.parttime.cservice.pojo.entity.WorkerTrainingRecord"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO worker_training_records (worker_id, course_id, status, score, started_at, completed_at)
        VALUES (#{workerId}, #{courseId}, #{status}, #{score}, #{startedAt}, #{completedAt})
    </insert>

    <update id="update" parameterType="com.parttime.cservice.pojo.entity.WorkerTrainingRecord">
        UPDATE worker_training_records
        SET status = #{status},
            score = #{score},
            completed_at = #{completedAt}
        WHERE id = #{id}
    </update>

</mapper>
