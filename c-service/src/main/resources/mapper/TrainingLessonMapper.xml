<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.parttime.cservice.mapper.TrainingLessonMapper">

    <resultMap id="TrainingLessonMap" type="com.parttime.cservice.pojo.entity.TrainingLesson">
        <id property="id" column="id"/>
        <result property="courseId" column="course_id"/>
        <result property="lessonType" column="lesson_type"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="mediaUrl" column="media_url"/>
        <result property="durationMinutes" column="duration_minutes"/>
        <result property="examConfigJson" column="exam_config_json"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findByCourseId" resultMap="TrainingLessonMap">
        SELECT * FROM training_lessons
        WHERE course_id = #{courseId} AND status = 'PUBLISHED'
        ORDER BY sort_order ASC, id ASC
    </select>

    <select id="findByCourseIds" resultMap="TrainingLessonMap">
        SELECT * FROM training_lessons
        WHERE status = 'PUBLISHED' AND course_id IN
        <foreach collection="courseIds" item="cid" open="(" separator="," close=")">
            #{cid}
        </foreach>
        ORDER BY sort_order ASC, id ASC
    </select>

    <select id="findById" resultMap="TrainingLessonMap">
        SELECT * FROM training_lessons WHERE id = #{id}
    </select>

</mapper>
