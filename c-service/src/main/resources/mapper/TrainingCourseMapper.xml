<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.parttime.cservice.mapper.TrainingCourseMapper">

    <resultMap id="TrainingCourseMap" type="com.parttime.cservice.pojo.entity.TrainingCourse">
        <id property="id" column="id"/>
        <result property="certificationId" column="certification_id"/>
        <result property="title" column="title"/>
        <result property="summary" column="summary"/>
        <result property="content" column="content"/>
        <result property="examJson" column="exam_json"/>
        <result property="passScore" column="pass_score"/>
        <result property="status" column="status"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findPublished" resultMap="TrainingCourseMap">
        SELECT * FROM training_courses WHERE status = 'PUBLISHED' ORDER BY sort_order ASC, id DESC
    </select>

    <select id="findById" resultMap="TrainingCourseMap">
        SELECT * FROM training_courses WHERE id = #{id}
    </select>

    <select id="findPublishedById" resultMap="TrainingCourseMap">
        SELECT * FROM training_courses WHERE id = #{id} AND status = 'PUBLISHED'
    </select>

</mapper>
