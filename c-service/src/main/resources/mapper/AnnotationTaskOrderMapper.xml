<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.parttime.cservice.mapper.AnnotationTaskOrderMapper">

    <resultMap id="annotationTaskOrderResultMap" type="com.parttime.cservice.pojo.entity.AnnotationTaskOrder" autoMapping="true">
        <id property="id" column="id"/>
        <result property="applicationId" column="application_id"/>
        <result property="scheduleId" column="schedule_id"/>
        <result property="workerId" column="worker_id"/>
        <result property="jobId" column="job_id"/>
        <result property="itemsCompleted" column="items_completed"/>
        <result property="externalSubmissionId" column="external_submission_id"/>
        <result property="submittedAt" column="submitted_at"/>
        <result property="completedAt" column="completed_at"/>
        <result property="settledAt" column="settled_at"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="selectByWorkerId" resultMap="annotationTaskOrderResultMap">
        SELECT * FROM annotation_task_orders WHERE worker_id = #{workerId} ORDER BY created_at DESC
    </select>

    <select id="selectById" resultMap="annotationTaskOrderResultMap">
        SELECT * FROM annotation_task_orders WHERE id = #{id}
    </select>

    <select id="aggregateGrabbedByScheduleIds" resultType="com.parttime.cservice.pojo.vo.AnnotationBatchProgress">
        SELECT schedule_id AS scheduleId,
               COUNT(*) AS grabbedCount
        FROM annotation_task_orders
        WHERE schedule_id IN
        <foreach collection="scheduleIds" item="scheduleId" open="(" separator="," close=")">
            #{scheduleId}
        </foreach>
        GROUP BY schedule_id
    </select>

</mapper>
