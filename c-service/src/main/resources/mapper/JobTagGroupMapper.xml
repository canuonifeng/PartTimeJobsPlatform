<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.parttime.cservice.mapper.JobTagGroupMapper">

    <select id="findActiveGroups" resultType="com.parttime.cservice.pojo.entity.JobTagGroup">
        SELECT * FROM job_tag_groups WHERE status = 'ACTIVE' ORDER BY sort_order ASC, id ASC
    </select>

</mapper>
