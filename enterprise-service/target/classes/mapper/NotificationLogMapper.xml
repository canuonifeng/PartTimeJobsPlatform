<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.parttime.enterprise.infrastructure.mapper.NotificationLogMapper">

    <resultMap id="NotificationLogResultMap" type="com.parttime.enterprise.core.domain.NotificationLog">
        <id property="id" column="id"/>
        <result property="recipientId" column="recipient_id"/>
        <result property="recipientType" column="recipient_type"/>
        <result property="type" column="type"/>
        <result property="channel" column="channel"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="status" column="status"/>
        <result property="errorMessage" column="error_message"/>
        <result property="sentAt" column="sent_at"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO notification_logs (recipient_id, recipient_type, type, channel, title, content, status)
        VALUES (#{recipientId}, #{recipientType}, #{type}, #{channel}, #{title}, #{content}, #{status})
    </insert>

    <select id="findById" resultMap="NotificationLogResultMap">
        SELECT * FROM notification_logs WHERE id = #{id}
    </select>

    <select id="findByRecipientIdAndRecipientType" resultMap="NotificationLogResultMap">
        SELECT * FROM notification_logs
        WHERE recipient_id = #{recipientId} AND recipient_type = #{recipientType}
        ORDER BY created_at DESC
    </select>

    <update id="updateStatus">
        UPDATE notification_logs SET status = #{status} WHERE id = #{id}
    </update>

    <update id="updateStatusWithError">
        UPDATE notification_logs SET status = #{status}, error_message = #{errorMessage} WHERE id = #{id}
    </update>

    <update id="markSent">
        UPDATE notification_logs SET status = 'SENT', sent_at = #{sentAt} WHERE id = #{id}
    </update>

</mapper>
