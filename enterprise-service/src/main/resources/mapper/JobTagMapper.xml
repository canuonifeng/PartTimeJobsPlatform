<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.parttime.enterprise.mapper.JobTagMapper">

    <resultMap id="JobTagGroupResultMap" type="com.parttime.enterprise.pojo.entity.JobTagGroup">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="code" column="code"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <resultMap id="JobTagResultMap" type="com.parttime.enterprise.pojo.entity.JobTag">
        <id property="id" column="id"/>
        <result property="groupId" column="group_id"/>
        <result property="name" column="name"/>
        <result property="code" column="code"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findActiveGroups" resultMap="JobTagGroupResultMap">
        SELECT * FROM job_tag_groups WHERE status = 'ACTIVE' ORDER BY sort_order ASC, id ASC
    </select>

    <select id="findActiveTags" resultMap="JobTagResultMap">
        SELECT * FROM job_tags WHERE status = 'ACTIVE' ORDER BY sort_order ASC, id ASC
    </select>

    <select id="findActiveExistingIds" resultType="java.lang.Long">
        SELECT t.id
        FROM job_tags t
        INNER JOIN job_tag_groups g ON t.group_id = g.id
        WHERE t.status = 'ACTIVE'
          AND g.status = 'ACTIVE'
          AND t.id IN
          <foreach collection="ids" item="id" open="(" separator="," close=")">
              #{id}
          </foreach>
    </select>

</mapper>
