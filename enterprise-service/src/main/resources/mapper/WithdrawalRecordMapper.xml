<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.parttime.enterprise.mapper.WithdrawalRecordMapper">

    <resultMap id="WithdrawalResultMap" type="com.parttime.enterprise.pojo.entity.WithdrawalRecord">
        <id property="id" column="id"/>
        <result property="workerId" column="worker_id"/>
        <result property="amount" column="amount"/>
        <result property="status" column="status"/>
        <result property="requestedAt" column="requested_at"/>
        <result property="completedAt" column="completed_at"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO withdrawal_records (worker_id, amount, status, requested_at)
        VALUES (#{workerId}, #{amount}, #{status}, #{requestedAt})
    </insert>

    <select id="findById" resultMap="WithdrawalResultMap">
        SELECT * FROM withdrawal_records WHERE id = #{id}
    </select>

    <select id="findByWorkerId" resultMap="WithdrawalResultMap">
        SELECT * FROM withdrawal_records WHERE worker_id = #{workerId} ORDER BY created_at DESC
    </select>

    <select id="findByWorkerIdAndStatus" resultMap="WithdrawalResultMap">
        SELECT * FROM withdrawal_records WHERE worker_id = #{workerId} AND status = #{status} ORDER BY created_at DESC
    </select>

    <update id="updateStatus">
        UPDATE withdrawal_records SET status = #{status} WHERE id = #{id}
    </update>

</mapper>
