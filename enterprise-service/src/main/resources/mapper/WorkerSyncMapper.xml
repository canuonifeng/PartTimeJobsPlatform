<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.parttime.enterprise.mapper.WorkerSyncMapper">

    <select id="findWorkerNameById" resultType="java.lang.String">
        SELECT name FROM c_worker WHERE id = #{id}
    </select>

    <select id="findWorkerPhoneById" resultType="java.lang.String">
        SELECT phone FROM c_worker WHERE id = #{id}
    </select>

    <select id="findWorkerBirthdayById" resultType="java.time.LocalDate">
        SELECT birthday FROM worker_profiles WHERE worker_id = #{id}
    </select>

    <select id="findWorkerGenderById" resultType="java.lang.String">
        SELECT gender FROM worker_profiles WHERE worker_id = #{id}
    </select>

    <select id="findWorkerRealNameStatusById" resultType="java.lang.String">
        SELECT COALESCE((SELECT status FROM worker_real_name_auth WHERE worker_id = #{id}), 'NONE')
    </select>

    <select id="findWorkerNamesByIds" resultType="java.util.Map">
        SELECT id, name FROM c_worker WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <select id="findWorkerPhonesByIds" resultType="java.util.Map">
        SELECT id, phone FROM c_worker WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <select id="findWorkerGendersByIds" resultType="java.util.Map">
        SELECT worker_id, gender FROM worker_profiles WHERE worker_id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <select id="findWorkerBirthdaysByIds" resultType="java.util.Map">
        SELECT worker_id, birthday FROM worker_profiles WHERE worker_id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <select id="findWorkerRealNameStatusesByIds" resultType="java.util.Map">
        SELECT worker_id, status FROM worker_real_name_auth WHERE worker_id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

</mapper>
