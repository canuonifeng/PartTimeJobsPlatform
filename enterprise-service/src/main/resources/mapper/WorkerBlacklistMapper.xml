<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.parttime.enterprise.mapper.WorkerBlacklistMapper">

    <resultMap id="BlacklistResultMap" type="com.parttime.enterprise.pojo.entity.WorkerBlacklist">
        <id property="id" column="id"/>
        <result property="companyId" column="company_id"/>
        <result property="workerId" column="worker_id"/>
        <result property="reason" column="reason"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO worker_blacklists (company_id, worker_id, reason)
        VALUES (#{companyId}, #{workerId}, #{reason})
    </insert>

    <select id="findByCompanyIdAndWorkerId" resultMap="BlacklistResultMap">
        SELECT * FROM worker_blacklists WHERE company_id = #{companyId} AND worker_id = #{workerId}
    </select>

    <delete id="deleteByCompanyIdAndWorkerId">
        DELETE FROM worker_blacklists WHERE company_id = #{companyId} AND worker_id = #{workerId}
    </delete>

</mapper>
