<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.parttime.enterprise.mapper.AttendanceRecordMapper">

    <resultMap id="RecordResultMap" type="com.parttime.enterprise.pojo.entity.AttendanceRecord">
        <id property="id" column="id"/>
        <result property="shiftId" column="shift_id"/>
        <result property="checkInTime" column="check_in_time"/>
        <result property="checkInLat" column="check_in_lat"/>
        <result property="checkInLng" column="check_in_lng"/>
        <result property="checkOutTime" column="check_out_time"/>
        <result property="checkOutLat" column="check_out_lat"/>
        <result property="checkOutLng" column="check_out_lng"/>
        <result property="totalHours" column="total_hours"/>
        <result property="payAmount" column="pay_amount"/>
        <result property="calculatedAt" column="calculated_at"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO attendance_records (shift_id, check_in_time, check_in_lat, check_in_lng,
                                        check_out_time, check_out_lat, check_out_lng,
                                        total_hours, pay_amount, calculated_at, status)
        VALUES (#{shiftId}, #{checkInTime}, #{checkInLat}, #{checkInLng},
                #{checkOutTime}, #{checkOutLat}, #{checkOutLng},
                #{totalHours}, #{payAmount}, #{calculatedAt}, #{status})
    </insert>

    <select id="findById" resultMap="RecordResultMap">
        SELECT * FROM attendance_records WHERE id = #{id}
    </select>

    <select id="findByShiftId" resultMap="RecordResultMap">
        SELECT * FROM attendance_records WHERE shift_id = #{shiftId}
    </select>

    <select id="findByShiftIds" resultMap="RecordResultMap">
        SELECT * FROM attendance_records WHERE shift_id IN
        <foreach collection="shiftIds" item="shiftId" open="(" separator="," close=")">
            #{shiftId}
        </foreach>
    </select>

    <update id="update">
        UPDATE attendance_records
        SET check_in_time = #{checkInTime}, check_in_lat = #{checkInLat}, check_in_lng = #{checkInLng},
            check_out_time = #{checkOutTime}, check_out_lat = #{checkOutLat}, check_out_lng = #{checkOutLng},
            total_hours = #{totalHours}, pay_amount = #{payAmount}, calculated_at = #{calculatedAt}, status = #{status}
        WHERE id = #{id}
    </update>

</mapper>
