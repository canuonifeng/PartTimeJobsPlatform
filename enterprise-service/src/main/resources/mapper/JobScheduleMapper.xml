<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.parttime.enterprise.infrastructure.mapper.JobScheduleMapper">

    <resultMap id="JobScheduleResultMap" type="com.parttime.enterprise.core.domain.JobSchedule">
        <id property="id" column="id"/>
        <result property="jobId" column="job_id"/>
        <result property="scheduleDate" column="schedule_date"/>
        <result property="startTime" column="start_time"/>
        <result property="endTime" column="end_time"/>
        <result property="slotsAvailable" column="slots_available"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO job_schedules (job_id, schedule_date, start_time, end_time, slots_available)
        VALUES (#{jobId}, #{scheduleDate}, #{startTime}, #{endTime}, #{slotsAvailable})
    </insert>

    <select id="findById" resultMap="JobScheduleResultMap">
        SELECT * FROM job_schedules WHERE id = #{id}
    </select>

    <select id="findByJobId" resultMap="JobScheduleResultMap">
        SELECT * FROM job_schedules WHERE job_id = #{jobId} ORDER BY schedule_date ASC, start_time ASC
    </select>

    <select id="findAll" resultMap="JobScheduleResultMap">
        SELECT * FROM job_schedules
    </select>

    <update id="update">
        UPDATE job_schedules
        SET schedule_date = #{scheduleDate}, start_time = #{startTime},
            end_time = #{endTime}, slots_available = #{slotsAvailable}
        WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM job_schedules WHERE id = #{id}
    </delete>

    <delete id="deleteByJobId">
        DELETE FROM job_schedules WHERE job_id = #{jobId}
    </delete>

</mapper>
