<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.parttime.enterprise.mapper.PayrollItemMapper">

    <resultMap id="ItemResultMap" type="com.parttime.enterprise.pojo.entity.PayrollItem">
        <id property="id" column="id"/>
        <result property="batchId" column="batch_id"/>
        <result property="workerId" column="worker_id"/>
        <result property="jobId" column="job_id"/>
        <result property="totalHours" column="total_hours"/>
        <result property="rateType" column="rate_type"/>
        <result property="rateAmount" column="rate_amount"/>
        <result property="totalPay" column="total_pay"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO payroll_items (batch_id, worker_id, job_id, total_hours, rate_type, rate_amount, total_pay, status)
        VALUES (#{batchId}, #{workerId}, #{jobId}, #{totalHours}, #{rateType}, #{rateAmount}, #{totalPay}, #{status})
    </insert>

    <insert id="insertBatch" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO payroll_items (batch_id, worker_id, job_id, total_hours, rate_type, rate_amount, total_pay, status)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.batchId}, #{item.workerId}, #{item.jobId}, #{item.totalHours}, #{item.rateType}, #{item.rateAmount}, #{item.totalPay}, #{item.status})
        </foreach>
    </insert>

    <select id="findById" resultMap="ItemResultMap">
        SELECT * FROM payroll_items WHERE id = #{id}
    </select>

    <select id="findByBatchId" resultMap="ItemResultMap">
        SELECT * FROM payroll_items WHERE batch_id = #{batchId}
    </select>

    <select id="findByBatchIdAndWorkerId" resultMap="ItemResultMap">
        SELECT * FROM payroll_items WHERE batch_id = #{batchId} AND worker_id = #{workerId}
    </select>

</mapper>
