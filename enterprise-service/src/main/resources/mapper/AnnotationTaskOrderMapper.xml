<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.parttime.enterprise.mapper.AnnotationTaskOrderMapper">

    <resultMap id="AnnotationTaskOrderResultMap" type="com.parttime.enterprise.pojo.entity.AnnotationTaskOrder" autoMapping="true">
        <id property="id" column="id"/>
        <result property="jobScheduleId" column="schedule_id"/>
        <result property="workerId" column="worker_id"/>
        <result property="status" column="status"/>
        <result property="completedItems" column="items_completed"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO annotation_task_orders (schedule_id, worker_id, status, items_completed, created_at, updated_at)
        VALUES (#{jobScheduleId}, #{workerId}, #{status}, #{completedItems}, NOW(), NOW())
    </insert>

    <update id="update">
        UPDATE annotation_task_orders
        SET status = #{status},
            items_completed = #{completedItems},
            updated_at = NOW()
        WHERE id = #{id}
    </update>

    <select id="selectById" resultMap="AnnotationTaskOrderResultMap">
        SELECT * FROM annotation_task_orders WHERE id = #{id}
    </select>

    <select id="selectByWorkerId" resultMap="AnnotationTaskOrderResultMap">
        SELECT * FROM annotation_task_orders WHERE worker_id = #{workerId} ORDER BY created_at DESC
    </select>

    <select id="selectByJobId" resultMap="AnnotationTaskOrderResultMap">
        SELECT * FROM annotation_task_orders WHERE job_id = #{jobId} ORDER BY created_at DESC
    </select>

    <select id="selectByApplicationId" resultMap="AnnotationTaskOrderResultMap">
        SELECT * FROM annotation_task_orders WHERE application_id = #{applicationId}
    </select>

    <select id="selectByExternalSubmissionId" resultMap="AnnotationTaskOrderResultMap">
        SELECT * FROM annotation_task_orders WHERE external_submission_id = #{externalSubmissionId}
    </select>

</mapper>
