<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.parttime.enterprise.infrastructure.mapper.JobRateMapper">

    <resultMap id="JobRateResultMap" type="com.parttime.enterprise.core.domain.JobRate">
        <id property="id" column="id"/>
        <result property="jobId" column="job_id"/>
        <result property="type" column="type"/>
        <result property="amount" column="amount"/>
        <result property="currency" column="currency"/>
        <result property="rules" column="rules"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO job_rates (job_id, type, amount, currency, rules)
        VALUES (#{jobId}, #{type}, #{amount}, #{currency}, #{rules})
    </insert>

    <select id="findById" resultMap="JobRateResultMap">
        SELECT * FROM job_rates WHERE id = #{id}
    </select>

    <select id="findByJobId" resultMap="JobRateResultMap">
        SELECT * FROM job_rates WHERE job_id = #{jobId}
    </select>

    <select id="findAll" resultMap="JobRateResultMap">
        SELECT * FROM job_rates
    </select>

    <update id="update">
        UPDATE job_rates
        SET type = #{type}, amount = #{amount}, currency = #{currency}, rules = #{rules}
        WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM job_rates WHERE id = #{id}
    </delete>

    <delete id="deleteByJobId">
        DELETE FROM job_rates WHERE job_id = #{jobId}
    </delete>

</mapper>
