<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.parttime.platform.infrastructure.mapper.JobCategoryMapper">

    <resultMap id="JobCategoryResultMap" type="com.parttime.platform.core.domain.JobCategory">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="parentId" column="parent_id"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO job_categories (name, parent_id, sort_order)
        VALUES (#{name}, #{parentId}, #{sortOrder})
    </insert>

    <select id="findById" resultMap="JobCategoryResultMap">
        SELECT * FROM job_categories WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="JobCategoryResultMap">
        SELECT * FROM job_categories ORDER BY sort_order ASC
    </select>

    <select id="findByParentId" resultMap="JobCategoryResultMap">
        SELECT * FROM job_categories WHERE parent_id = #{parentId} ORDER BY sort_order ASC
    </select>

    <update id="update">
        UPDATE job_categories
        SET name = #{name}, parent_id = #{parentId}, sort_order = #{sortOrder}
        WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM job_categories WHERE id = #{id}
    </delete>

</mapper>
