<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.parttime.platform.infrastructure.mapper.EnterpriseRegistrationMapper">

    <resultMap id="EnterpriseRegistrationResultMap" type="com.parttime.platform.core.domain.EnterpriseRegistration">
        <id property="id" column="id"/>
        <result property="companyName" column="company_name"/>
        <result property="contactName" column="contact_name"/>
        <result property="contactPhone" column="contact_phone"/>
        <result property="companyAddress" column="company_address"/>
        <result property="businessLicense" column="business_license"/>
        <result property="status" column="status"/>
        <result property="reviewerId" column="reviewer_id"/>
        <result property="reviewRemark" column="review_remark"/>
        <result property="reviewedAt" column="reviewed_at"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findById" resultMap="EnterpriseRegistrationResultMap">
        SELECT * FROM enterprise_registrations WHERE id = #{id}
    </select>

    <select id="findByStatus" resultMap="EnterpriseRegistrationResultMap">
        SELECT * FROM enterprise_registrations WHERE status = #{status} ORDER BY created_at DESC
    </select>

    <select id="findAll" resultMap="EnterpriseRegistrationResultMap">
        SELECT * FROM enterprise_registrations ORDER BY created_at DESC
    </select>

    <update id="update">
        UPDATE enterprise_registrations
        SET status = #{status},
            reviewer_id = #{reviewerId},
            review_remark = #{reviewRemark},
            reviewed_at = #{reviewedAt}
        WHERE id = #{id}
    </update>

</mapper>
