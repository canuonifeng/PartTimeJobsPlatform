<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.parttime.platform.mapper.EnterpriseTopUpMapper">
    <resultMap id="TopUpResultMap" type="com.parttime.platform.pojo.entity.EnterpriseTopUp">
        <id property="id" column="id"/>
        <result property="companyId" column="company_id"/>
        <result property="enterpriseName" column="enterprise_name"/>
        <result property="amount" column="amount"/>
        <result property="status" column="status"/>
        <result property="serialNumber" column="serial_number"/>
        <result property="thirdPartySerialNo" column="third_party_serial_no"/>
        <result property="thirdPartyPlatform" column="third_party_platform"/>
        <result property="completedAt" column="completed_at"/>
        <result property="auditor" column="auditor"/>
        <result property="auditRemark" column="audit_remark"/>
        <result property="auditedAt" column="audited_at"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="findByFilters" resultMap="TopUpResultMap">
        SELECT t.*, e.company_name AS enterprise_name FROM enterprise_top_up_records t
        LEFT JOIN enterprises e ON t.company_id = e.id
        <where>
            <if test="status != null and status != ''">AND t.status = #{status}</if>
            <if test="keyword != null and keyword != ''">AND e.company_name LIKE CONCAT('%', #{keyword}, '%')</if>
        </where>
        ORDER BY t.created_at DESC
    </select>

    <select id="findById" resultMap="TopUpResultMap">
        SELECT t.*, e.company_name AS enterprise_name FROM enterprise_top_up_records t
        LEFT JOIN enterprises e ON t.company_id = e.id WHERE t.id = #{id}
    </select>

    <update id="updateStatus">
        UPDATE enterprise_top_up_records SET status = #{status}, auditor = #{auditor}, audited_at = NOW(), audit_remark = #{remark} WHERE id = #{id}
    </update>
</mapper>
