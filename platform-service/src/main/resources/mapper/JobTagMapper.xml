<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.parttime.platform.mapper.JobTagMapper">

    <resultMap id="JobTagGroupResultMap" type="com.parttime.platform.pojo.entity.JobTagGroup">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="code" column="code"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <resultMap id="JobTagResultMap" type="com.parttime.platform.pojo.entity.JobTag">
        <id property="id" column="id"/>
        <result property="groupId" column="group_id"/>
        <result property="name" column="name"/>
        <result property="code" column="code"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insertGroup" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO job_tag_groups (name, code, sort_order, status)
        VALUES (#{name}, #{code}, #{sortOrder}, #{status})
    </insert>

    <select id="findGroupById" resultMap="JobTagGroupResultMap">
        SELECT * FROM job_tag_groups WHERE id = #{id}
    </select>

    <select id="findAllGroups" resultMap="JobTagGroupResultMap">
        SELECT * FROM job_tag_groups ORDER BY sort_order ASC, id ASC
    </select>

    <update id="updateGroup">
        UPDATE job_tag_groups
        SET name = #{name}, code = #{code}, sort_order = #{sortOrder}, status = #{status}
        WHERE id = #{id}
    </update>

    <update id="disableGroup">
        UPDATE job_tag_groups
        SET status = 'DISABLED'
        WHERE id = #{id}
    </update>

    <update id="disableTagsByGroupId">
        UPDATE job_tags
        SET status = 'DISABLED'
        WHERE group_id = #{groupId}
    </update>

    <insert id="insertTag" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO job_tags (group_id, name, code, sort_order, status)
        VALUES (#{groupId}, #{name}, #{code}, #{sortOrder}, #{status})
    </insert>

    <select id="findTagById" resultMap="JobTagResultMap">
        SELECT * FROM job_tags WHERE id = #{id}
    </select>

    <select id="findAllTags" resultMap="JobTagResultMap">
        SELECT * FROM job_tags ORDER BY sort_order ASC, id ASC
    </select>

    <update id="updateTag">
        UPDATE job_tags
        SET group_id = #{groupId}, name = #{name}, code = #{code}, sort_order = #{sortOrder}, status = #{status}
        WHERE id = #{id}
    </update>

    <update id="disableTag">
        UPDATE job_tags
        SET status = 'DISABLED'
        WHERE id = #{id}
    </update>

</mapper>
