<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.parttime.platform.mapper.LeadMapper">

    <resultMap id="LeadResultMap" type="com.parttime.platform.pojo.entity.Lead">
        <id property="id" column="id"/>
        <result property="contactName" column="contact_name"/>
        <result property="companyName" column="company_name"/>
        <result property="phone" column="phone"/>
        <result property="demand" column="demand"/>
        <result property="sourcePage" column="source_page"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO leads (contact_name, company_name, phone, demand, source_page, status)
        VALUES (#{contactName}, #{companyName}, #{phone}, #{demand}, #{sourcePage}, #{status})
    </insert>

</mapper>
