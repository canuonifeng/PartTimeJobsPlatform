<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.parttime.platform.mapper.ReviewMapper">

    <resultMap id="ReviewResultMap" type="com.parttime.platform.pojo.entity.Review">
        <id property="id" column="id"/>
        <result property="reviewType" column="review_type"/>
        <result property="reviewerId" column="reviewer_id"/>
        <result property="reviewerName" column="reviewer_name"/>
        <result property="reviewerType" column="reviewer_type"/>
        <result property="revieweeId" column="reviewee_id"/>
        <result property="revieweeName" column="reviewee_name"/>
        <result property="revieweeType" column="reviewee_type"/>
        <result property="jobId" column="job_id"/>
        <result property="jobTitle" column="job_title"/>
        <result property="scheduleId" column="schedule_id"/>
        <result property="rating" column="rating"/>
        <result property="content" column="content"/>
        <result property="images" column="images"/>
        <result property="tags" column="tags"/>
        <result property="isAnonymous" column="is_anonymous"/>
        <result property="isViolation" column="is_violation"/>
        <result property="violationReason" column="violation_reason"/>
        <result property="violationHandledAt" column="violation_handled_at"/>
        <result property="violationHandlerId" column="violation_handler_id"/>
        <result property="violationHandlerName" column="violation_handler_name"/>
        <result property="replyContent" column="reply_content"/>
        <result property="replyAt" column="reply_at"/>
        <result property="status" column="status"/>
        <result property="helpfulCount" column="helpful_count"/>
        <result property="reportCount" column="report_count"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findByFilters" resultMap="ReviewResultMap">
        SELECT * FROM reviews
        <where>
            status != 'DELETED'
            <if test="reviewType != null and reviewType != ''">
                AND review_type = #{reviewType}
            </if>
            <if test="isViolation != null">
                AND is_violation = #{isViolation}
            </if>
            <if test="rating != null">
                AND rating = #{rating}
            </if>
            <if test="keyword != null and keyword != ''">
                AND (reviewer_name LIKE CONCAT('%', #{keyword}, '%')
                     OR reviewee_name LIKE CONCAT('%', #{keyword}, '%')
                     OR job_title LIKE CONCAT('%', #{keyword}, '%')
                     OR content LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
        ORDER BY created_at DESC
    </select>

    <select id="findById" resultMap="ReviewResultMap">
        SELECT * FROM reviews WHERE id = #{id}
    </select>

    <update id="markViolation">
        UPDATE reviews
        SET is_violation = 1,
            violation_reason = #{reason},
            violation_handled_at = NOW(),
            violation_handler_name = #{operatorName},
            status = 'HIDDEN'
        WHERE id = #{id}
    </update>

    <update id="softDelete">
        UPDATE reviews SET status = 'DELETED' WHERE id = #{id}
    </update>

    <update id="updateWorkerCreditScore">
        UPDATE c_worker SET credit_score = credit_score + #{delta} WHERE id = #{targetId}
    </update>

    <update id="updateEnterpriseCreditScore">
        UPDATE enterprise_accounts SET credit_score = credit_score + #{delta} WHERE id = #{targetId}
    </update>

    <insert id="insertCreditScoreLog">
        INSERT INTO operation_logs
            (operator_name, module, operation_type, target_type, target_id, target_name, remark, result, created_at)
        VALUES
            (#{operatorName}, 'RISK', 'UPDATE', #{targetType}, #{targetId}, CONCAT('credit_score ', #{delta}), #{reason}, 'SUCCESS', NOW())
    </insert>

</mapper>
