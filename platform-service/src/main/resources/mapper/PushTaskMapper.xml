<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.parttime.platform.mapper.PushTaskMapper">

    <resultMap id="PushTaskResultMap" type="com.parttime.platform.pojo.entity.PushTask">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="targetType" column="target_type"/>
        <result property="targetIds" column="target_ids"/>
        <result property="pushType" column="push_type"/>
        <result property="scheduledTime" column="scheduled_time"/>
        <result property="status" column="status"/>
        <result property="totalCount" column="total_count"/>
        <result property="successCount" column="success_count"/>
        <result property="failCount" column="fail_count"/>
        <result property="operatorId" column="operator_id"/>
        <result property="operatorName" column="operator_name"/>
        <result property="completedAt" column="completed_at"/>
        <result property="remark" column="remark"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findAll" resultMap="PushTaskResultMap">
        SELECT * FROM push_tasks ORDER BY created_at DESC
    </select>

    <select id="findById" resultMap="PushTaskResultMap">
        SELECT * FROM push_tasks WHERE id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO push_tasks
            (title, content, target_type, target_ids, push_type, scheduled_time,
             status, total_count, success_count, fail_count, operator_id, operator_name, remark)
        VALUES
            (#{title}, #{content}, #{targetType}, #{targetIds}, #{pushType}, #{scheduledTime},
             'PENDING', #{totalCount}, 0, 0, #{operatorId}, #{operatorName}, #{remark})
    </insert>

    <update id="update">
        UPDATE push_tasks
        SET title = #{title},
            content = #{content},
            target_type = #{targetType},
            target_ids = #{targetIds},
            push_type = #{pushType},
            scheduled_time = #{scheduledTime},
            remark = #{remark}
        WHERE id = #{id}
    </update>

    <update id="updateStatus">
        UPDATE push_tasks SET status = #{status} WHERE id = #{id}
    </update>

</mapper>
