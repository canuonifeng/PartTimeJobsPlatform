<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.parttime.platform.mapper.WithdrawalRecordMapper">

    <resultMap id="WithdrawalRecordResultMap" type="com.parttime.platform.pojo.entity.WithdrawalRecord">
        <id property="id" column="id"/>
        <result property="workerId" column="worker_id"/>
        <result property="workerName" column="worker_name"/>
        <result property="workerPhone" column="worker_phone"/>
        <result property="amount" column="amount"/>
        <result property="status" column="status"/>
        <result property="bankInfo" column="bank_info"/>
        <result property="remark" column="remark"/>
        <result property="requestedAt" column="requested_at"/>
        <result property="processedAt" column="processed_at"/>
        <result property="completedAt" column="completed_at"/>
        <result property="thirdPartySerialNo" column="third_party_serial_no"/>
        <result property="thirdPartyPlatform" column="third_party_platform"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findPage" resultMap="WithdrawalRecordResultMap">
        SELECT r.*
        FROM c_withdrawal_record r
        <where>
            <if test="workerId != null">
                AND r.worker_id = #{workerId}
            </if>
            <if test="status != null and status != ''">
                AND r.status = #{status}
            </if>
            <if test="startTime != null">
                AND r.created_at &gt;= #{startTime}
            </if>
            <if test="endTime != null">
                AND r.created_at &lt;= #{endTime}
            </if>
        </where>
        ORDER BY r.created_at DESC
        LIMIT #{pageSize} OFFSET #{offset}
    </select>

    <select id="countPage" resultType="long">
        SELECT COUNT(*)
        FROM c_withdrawal_record r
        <where>
            <if test="workerId != null">
                AND r.worker_id = #{workerId}
            </if>
            <if test="status != null and status != ''">
                AND r.status = #{status}
            </if>
            <if test="startTime != null">
                AND r.created_at &gt;= #{startTime}
            </if>
            <if test="endTime != null">
                AND r.created_at &lt;= #{endTime}
            </if>
        </where>
    </select>
</mapper>
