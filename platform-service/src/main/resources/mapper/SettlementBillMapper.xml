<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.parttime.platform.mapper.SettlementBillMapper">

    <resultMap id="SettlementBillResultMap" type="com.parttime.platform.pojo.entity.SettlementBill">
        <id property="id" column="id"/>
        <result property="companyId" column="company_id"/>
        <result property="companyName" column="company_name"/>
        <result property="jobId" column="job_id"/>
        <result property="shiftId" column="shift_id"/>
        <result property="workerId" column="worker_id"/>
        <result property="workerName" column="worker_name"/>
        <result property="shiftDate" column="shift_date"/>
        <result property="startTime" column="start_time"/>
        <result property="endTime" column="end_time"/>
        <result property="totalHours" column="total_hours"/>
        <result property="rateType" column="rate_type"/>
        <result property="rateAmount" column="rate_amount"/>
        <result property="scheduledPay" column="scheduled_pay"/>
        <result property="actualPay" column="actual_pay"/>
        <result property="serialNumber" column="serial_number"/>
        <result property="thirdPartySerialNo" column="third_party_serial_no"/>
        <result property="thirdPartyPlatform" column="third_party_platform"/>
        <result property="status" column="status"/>
        <result property="paidAt" column="paid_at"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findByShiftId" resultMap="SettlementBillResultMap">
        SELECT b.*, e.company_name
        FROM settlement_bills b
        LEFT JOIN enterprises e ON b.company_id = e.id
        WHERE b.shift_id = #{shiftId}
        LIMIT 1
    </select>

    <select id="findPage" resultMap="SettlementBillResultMap">
        SELECT b.*, e.company_name
        FROM settlement_bills b
        LEFT JOIN enterprises e ON b.company_id = e.id
        <where>
            <if test="companyId != null">
                AND b.company_id = #{companyId}
            </if>
            <if test="workerName != null and workerName != ''">
                AND b.worker_name LIKE CONCAT('%', #{workerName}, '%')
            </if>
            <if test="dateFrom != null">
                AND b.shift_date &gt;= #{dateFrom}
            </if>
            <if test="dateTo != null">
                AND b.shift_date &lt;= #{dateTo}
            </if>
            <if test="status != null and status != ''">
                AND b.status = #{status}
            </if>
        </where>
        ORDER BY b.created_at DESC
        LIMIT #{pageSize} OFFSET #{offset}
    </select>

    <select id="countPage" resultType="long">
        SELECT COUNT(*) FROM settlement_bills b
        <where>
            <if test="companyId != null">
                AND b.company_id = #{companyId}
            </if>
            <if test="workerName != null and workerName != ''">
                AND b.worker_name LIKE CONCAT('%', #{workerName}, '%')
            </if>
            <if test="dateFrom != null">
                AND b.shift_date &gt;= #{dateFrom}
            </if>
            <if test="dateTo != null">
                AND b.shift_date &lt;= #{dateTo}
            </if>
            <if test="status != null and status != ''">
                AND b.status = #{status}
            </if>
        </where>
    </select>

    <update id="updateBillStatus">
        UPDATE settlement_bills SET status = #{status} WHERE id = #{id}
    </update>

</mapper>
