# 通义千问 API
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QWEN_MODEL=qwen-max

# 阿里云 ASR
ALIBABA_CLOUD_ACCESS_KEY_ID=your_access_key_id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_access_key_secret
ALIBABA_CLOUD_REGION=cn-shanghai

# Enterprise Service
ENTERPRISE_SERVICE_BASE_URL=http://localhost:8081/api

# JWT Secret (must match enterprise-service application.yml: jwt.secret)
JWT_SECRET=parttime-enterprise-jwt-secret-key-must-be-at-least-256-bits

# Server
AI_PROXY_HOST=0.0.0.0
AI_PROXY_PORT=8000
UPLOAD_DIR=./uploads
